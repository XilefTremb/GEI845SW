      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <joint name="j_elbow_l" type="revolute">
    <parent link="left_arm_high"/>
    <child link="left_arm_low"/>
    <origin xyz="0.0 -0.060 0.016" rpy="-1.5707 0 0" />
